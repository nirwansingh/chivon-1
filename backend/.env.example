# Copy the repo root .env or set these in backend/.env.
# The server also reads ../.env when started from backend/.

DATABASE_URL="postgresql://USER@localhost:5432/chivon_dev?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
DEV_USER_SWITCH="true"

# Optional document storage (Supabase). Local files are used when these are unset.
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_SECRET=""
