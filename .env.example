DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public" # Connection string for PostgreSQL
AUTH_SECRET="your-secret-here" # Secret for NextAuth (generate with `openssl rand -base64 32`)
AUTH_URL="http://localhost:3000" # Base URL of the application
STORAGE_URL="https://your-project.supabase.co" # Supabase project URL for object storage
STORAGE_KEY="your-supabase-anon-key" # Supabase anonymous key
STORAGE_SECRET="your-supabase-service-role-key" # Supabase service role key
DEV_USER_SWITCH="true" # Enable easy dev user switching (true/false)
API_URL="http://localhost:4000" # Backend API used by the Next.js server
FRONTEND_ORIGIN="http://localhost:3000" # Allowed browser origin for the API
